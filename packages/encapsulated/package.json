{
    "name": "@dcmjs-org/encapsulated",
    "version": "0.0.0",
    "description": "Encapsulated document IODs: wrap a document into a conformant naturalized DICOM dataset and recover the exact bytes from a parsed instance. PDF (SOP Class 1.2.840.10008.5.1.4.1.1.104.1) today; the other encapsulated-document types (CDA, STL, OBJ, MTL) share the same home",
    "main": "./src/index.js",
    "exports": {
        ".": {
            "source": "./src/index.js",
            "import": "./dist/index.mjs",
            "default": "./src/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "rollup -c ../../rollup.packages.config.mjs"
    },
    "publishConfig": {
        "main": "./dist/index.cjs",
        "module": "./dist/index.mjs",
        "exports": {
            ".": {
                "import": "./dist/index.mjs",
                "require": "./dist/index.cjs"
            },
            "./package.json": "./package.json"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dcmjs-org/dcmjs.git",
        "directory": "packages/encapsulated"
    },
    "dependencies": {
        "@dcmjs-org/core": "workspace:*"
    }
}
