{
    "name": "@dcmjs-org/media",
    "version": "0.0.0",
    "description": "The dcmjs bulk-data bundle: DICOMDIR building (@dcmjs-org/dicomdir), Encapsulated PDF wrapping (@dcmjs-org/encapsulated), image building (@dcmjs-org/imaging), and video encapsulation (@dcmjs-org/video) re-exported under the stable dcmjs media, encapsulated, and image namespaces",
    "main": "./src/index.js",
    "exports": {
        ".": {
            "source": "./src/index.js",
            "import": "./dist/index.mjs",
            "default": "./src/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "rollup -c ../../rollup.packages.config.mjs"
    },
    "publishConfig": {
        "main": "./dist/index.cjs",
        "module": "./dist/index.mjs",
        "exports": {
            ".": {
                "import": "./dist/index.mjs",
                "require": "./dist/index.cjs"
            },
            "./package.json": "./package.json"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dcmjs-org/dcmjs.git",
        "directory": "packages/media"
    },
    "dependencies": {
        "@dcmjs-org/dicomdir": "workspace:*",
        "@dcmjs-org/encapsulated": "workspace:*",
        "@dcmjs-org/imaging": "workspace:*",
        "@dcmjs-org/video": "workspace:*"
    }
}
