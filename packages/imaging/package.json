{
    "name": "@dcmjs-org/imaging",
    "version": "0.0.0",
    "description": "Lightweight, codec-free image building for dcmjs: turn already-decoded pixels into a conformant DICOM image instance, and inspect JPEG/H.264 headers without decoding. The heavy MP4/video processing lives in @dcmjs-org/video",
    "main": "./src/index.js",
    "exports": {
        ".": {
            "source": "./src/index.js",
            "import": "./dist/index.mjs",
            "default": "./src/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "rollup -c ../../rollup.packages.config.mjs"
    },
    "publishConfig": {
        "main": "./dist/index.cjs",
        "module": "./dist/index.mjs",
        "exports": {
            ".": {
                "import": "./dist/index.mjs",
                "require": "./dist/index.cjs"
            },
            "./package.json": "./package.json"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dcmjs-org/dcmjs.git",
        "directory": "packages/imaging"
    },
    "dependencies": {
        "@dcmjs-org/core": "workspace:*"
    }
}
