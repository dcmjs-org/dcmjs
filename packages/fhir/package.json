{
    "name": "@dcmjs-org/fhir",
    "version": "0.0.0",
    "description": "DICOM ↔ FHIR R4B mapping for Patient, ImagingStudy and DocumentReference resources from naturalized dcmjs datasets",
    "main": "./src/index.js",
    "exports": {
        ".": {
            "source": "./src/index.js",
            "import": "./dist/index.mjs",
            "default": "./src/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "rollup -c ../../rollup.packages.config.mjs"
    },
    "publishConfig": {
        "main": "./dist/index.cjs",
        "module": "./dist/index.mjs",
        "exports": {
            ".": {
                "import": "./dist/index.mjs",
                "require": "./dist/index.cjs"
            },
            "./package.json": "./package.json"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dcmjs-org/dcmjs.git",
        "directory": "packages/fhir"
    },
    "dependencies": {
        "@dcmjs-org/core": "workspace:*",
        "@dcmjs-org/encapsulated": "workspace:*"
    },
    "devDependencies": {
        "@dcmjs-org/legacy": "workspace:*",
        "@dcmjs-org/parser": "workspace:*"
    }
}
