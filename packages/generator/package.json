{
    "name": "@dcmjs-org/generator",
    "version": "0.0.0",
    "description": "The event-stream writing side of dcmjs: the sinks that turn contract events into DICOM Part 10 bytes (collected or streaming) and DICOMweb JSON",
    "main": "./src/index.js",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "rollup -c ../../rollup.packages.config.mjs"
    },
    "publishConfig": {
        "main": "./dist/index.cjs",
        "module": "./dist/index.mjs",
        "exports": {
            ".": {
                "import": "./dist/index.mjs",
                "require": "./dist/index.cjs"
            },
            "./package.json": "./package.json"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dcmjs-org/dcmjs.git",
        "directory": "packages/generator"
    },
    "dependencies": {
        "@dcmjs-org/core": "workspace:*",
        "@dcmjs-org/parser": "workspace:*"
    }
}
