{"nodes": [{"id": "packages_docs_docs_architecture_overview_layered_architecture", "label": "dcmjs Layered Architecture", "file_type": "concept", "rationale": "Layer 0 offset tokenizer (dependency-free), layer 1 data model, layer 2 features, edge adapters; arrows only point downward \u2014 the parser never imports dcmjs, never touches the dictionary, never decodes character sets, by design.", "source_file": "packages/docs/docs/architecture/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_overview_derivability_argument", "label": "Derivability Argument (Offsets over Values)", "file_type": "rationale", "rationale": "Offsets can always produce values (decode lazily, with any charset, or never), but eager values cannot recover offsets \u2014 once decoded, the exact framing is gone. Recording offsets is the more fundamental representation, buying lazy reads and byte-faithful writes; startOffset/endOffset were added because dataOffset alone is ambiguous.", "source_file": "packages/docs/docs/architecture/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_overview_pnpm_monorepo", "label": "dcmjs pnpm Monorepo Structure", "file_type": "concept", "source_file": "packages/docs/docs/architecture/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "packages_docs_docs_architecture_overview_layered_architecture", "target": "packages_docs_docs_architecture_parser_package_dcmjs_parser", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/overview.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_overview_layered_architecture", "target": "packages_docs_docs_architecture_laz