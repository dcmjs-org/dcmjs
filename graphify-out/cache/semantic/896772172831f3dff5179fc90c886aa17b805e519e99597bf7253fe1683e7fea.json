{"nodes": [{"id": "packages_docs_docs_performance_measured_numbers", "label": "Measured Performance Numbers", "file_type": "document", "rationale": "Vendored tokenizer geomean ~0.84-0.85 vs published dicom-parser (faster on every corpus file); writer 1.76x on SR trees and 3.23x on large values; 199 MB to 4 KB allocation drop; dictionary import 181 ms to 19 ms. All measured on one developer machine \u2014 relative indicators, not absolute promises.", "source_file": "packages/docs/docs/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_performance_standing_gates", "label": "Standing Performance Gates", "file_type": "concept", "rationale": "bench:parser (geomean <= 1.10, single file <= 1.25), gate:parser-bundle (self-containment, <= 120 kB, no pako, side-effect-free import), the byte-identity suite, and dual-core equivalence (635 + 245 tests) must all stay green.", "source_file": "packages/docs/docs/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_performance_laziness_characteristics", "label": "Laziness Characteristics", "file_type": "concept", "rationale": "Parse cost is independent of value sizes; memory is ~1x the file because the source buffer is retained and binary values are views; laziness wins when touching a subset \u2014 a workload touching every value approaches eager cost plus getter indirection.", "source_file": "packages/docs/docs/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "packages_docs_docs_performance_measured_numbers", "target": "packages_docs_docs_performance_standing_gates", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/performance.md", "source_location": null, "weight": 1.0}, {"