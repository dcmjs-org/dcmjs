{"nodes": [{"id": "packages_docs_docs_architecture_writer_backpatch_writer", "label": "Backpatching Re-encoder", "file_type": "concept", "rationale": "Replaces the 0.x per-element temp stream and double copy: write directly into the destination, reserve the length field, backpatch it with writeUint16At/writeUint32At after the VR class encodes.", "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_writer_passthrough_fast_path", "label": "Passthrough Fast Path", "file_type": "concept", "rationale": "A never-edited lazy entry knows its exact on-disk encoding (_sourceSpan), so the writer skips encoding entirely and copies whole SQ subtrees and encapsulated PixelData runs in one subarray each \u2014 byte-identical, header to delimiter.", "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_writer_big16_substitution", "label": "Big 16 UN Substitution", "file_type": "concept", "rationale": "An 8-byte short explicit header cannot be backpatched into the 12-byte Big 16 layout, so the writer decides up front: fixed-size VRs emit the right header immediately; variable-length values are screened by a deliberately over-estimating valueByteUpperBound and only possible overflows take the measured path.", "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_writer_zero_copy_windows", "label": "Zero-Copy Windows (writeRawBytes)", "file_type": "concept", "rationale": "Spans of 64 KB or more become read-only zero-copy windows over the source buffer instead of copies; window chunks are marked read-only so a misdirected length backpatch can never corrupt the caller's source buffer.", "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_writer_dirty_tracking", "label": "Assignment-Based Dirty Tracking", "file_type": "concept", "rationale": "Dirtiness is assignment-based by design: setters flip _dirty and bump _nestedDirtCount up the enclosing-sequence chain; structural sequence edits are re-verified at write time (sqStructureDiverged). In-place mutation is undetectable by design and documented.", "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_writer_byte_identity_guarantee", "label": "Byte-Identity Guarantee", "file_type": "concept", "rationale": "For an eligible file read by the lazy core and written back with zero edits, same syntax, default options, and a passthrough-safe charset, the dataset body is reproduced byte-for-byte \u2014 a guarantee 0.x never had, pinned by round-trip suites over an adversarial corpus.", "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_writer_deflate_on_write", "label": "Deflate on Write", "file_type": "concept", "rationale": "Per PS3.10 A.5 the preamble, DICM, and meta group are written uncompressed and the body raw-deflated (RFC 1951); a deflated source's spans index the inflated body buffer, so passthrough composes and only the deflate wrapper is recomputed.", "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "packages_docs_docs_architecture_writer_backpatch_writer", "target": "packages_docs_docs_architecture_writer_big16_substitution", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_writer_passthrough_fast_path", "target": "packages_docs_docs_architecture_writer_dirty_tracking", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_writer_passthrough_fast_path", "target": "packages_docs_docs_architecture_writer_zero_copy_windows", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_writer_zero_copy_windows", "target": "packages_docs_docs_architecture_streaming_splitdataview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_writer_byte_identity_guarantee", "target": "packages_docs_docs_architecture_writer_passthrough_fast_path", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_writer_deflate_on_write", "target": "packages_docs_docs_guides_deflate_deflated_transfer_syntax", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_writer_dirty_tracking", "target": "packages_docs_docs_architecture_lazy_core_getter_backed_entries", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_writer_passthrough_fast_path", "target": "packages_docs_docs_guides_character_sets_charset_passthrough_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_writer_byte_identity_guarantee", "target": "packages_docs_docs_performance_measured_numbers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/writer.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "byte_faithful_write_pipeline", "label": "Byte-Faithful Write Pipeline", "nodes": ["packages_docs_docs_architecture_parser_package_element_model", "packages_docs_docs_architecture_lazy_core_getter_backed_entries", "packages_docs_docs_architecture_writer_dirty_tracking", "packages_docs_docs_architecture_writer_passthrough_fast_path", "packages_docs_docs_architecture_writer_byte_identity_guarantee"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/writer.md"}]}