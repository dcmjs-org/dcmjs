{"nodes": [{"id": "packages_docs_docs_architecture_lazy_core_lazy_read_core", "label": "Lazy Read Core (LazyDicomReader)", "file_type": "concept", "source_file": "packages/docs/docs/architecture/lazy-core.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_lazy_core_getter_backed_entries", "label": "Getter-Backed Lazy Entries", "file_type": "concept", "rationale": "Entries keep the eager { vr, Value, _rawValue } observable shape but Value/_rawValue are accessor properties: the getter materializes and caches on first access; the setter flips the _dirty flag \u2014 the seam the passthrough writer is built on. No behavioral cliff, only deferred work.", "source_file": "packages/docs/docs/architecture/lazy-core.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_lazy_core_windowed_materialization", "label": "Windowed Stream Materialization", "file_type": "concept", "rationale": "The VR classes were not rewritten: ReadBufferStream {start, stop} windows let materialization run exactly the vr.read call the eager reader made \u2014 one small stream allocation per first access is the cost of this correctness-first bridge.", "source_file": "packages/docs/docs/architecture/lazy-core.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_lazy_core_per_item_charset_contexts", "label": "Per-Item Charset Contexts", "file_type": "concept", "rationale": "There is no scan in the lazy model, so the decoder is resolved once per dataset at wrap time; sequence items carrying their own 0008,0005 get per-item contexts \u2014 exceeding the 0.x reader's single-charset-per-file support.", "source_file": "packages/docs/docs/architecture/lazy-core.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_lazy_core_whole_file_eager_fallback", "label": "Whole-File Eager Fallback", "file_type": "concept", "rationale": "When the tokenizer rejects a stream outright (truncated files, overrunning lengths, missing part-10 plumbing), the entire read is delegated to the eager core so its exact behavior \u2014 including errors and ignoreErrors recovery points \u2014 is reproduced by running it.", "source_file": "packages/docs/docs/architecture/lazy-core.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_lazy_core_eager_core_escape_hatch", "label": "Eager Core Escape Hatch (DCMJS_CORE)", "file_type": "concept", "rationale": "The historical eager read loop is kept behind core:'eager'/DCMJS_CORE=eager as a beta-soak escape hatch, not a supported long-term mode; slated for deletion in 1.x once the async reader is re-platformed onto the tokenizer.", "source_file": "packages/docs/docs/architecture/lazy-core.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_lazy_core_documented_divergences", "label": "Documented Divergences from 0.x Eager Reader", "file_type": "concept", "rationale": "Three intentional, test-pinned divergences: value-level errors throw at first access instead of during readFile; ignoreErrors:true returns the full dict with the failing entry undefined instead of truncating (strictly more informative); charset scope applies per dataset/item, diverging only on non-conformant element ordering.", "source_file": "packages/docs/docs/architecture/lazy-core.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "packages_docs_docs_architecture_lazy_core_lazy_read_core", "target": "packages_docs_docs_architecture_parser_package_dcmjs_parser", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/lazy-core.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_lazy_core_getter_backed_entries", "target": "packages_docs_docs_architecture_lazy_core_lazy_read_core", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/lazy-core.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_lazy_core_windowed_materialization", "target": "packages_docs_docs_architecture_lazy_core_lazy_read_core", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/lazy-core.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_lazy_core_getter_backed_entries", "target": "packages_docs_docs_architecture_writer_passthrough_fast_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/lazy-core.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_lazy_core_lazy_read_core", "target": "packages_docs_docs_architecture_dictionary_packed_dictionary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/lazy-core.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_lazy_core_per_item_charset_contexts", "target": "packages_docs_docs_architecture_lazy_core_lazy_read_core", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/lazy-core.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_lazy_core_per_item_charset_contexts", "target": "packages_doc